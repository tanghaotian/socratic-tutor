# 运行时配置（复制为 .env 并填入真实值；.env 不入库）
NODE_ENV=development

# ---- LLM Provider（单一 OpenAI 兼容注册清单，默认豆包 Doubao）----
# 可选：doubao | deepseek | qwen | 任意通过 LLM_EXTRA_MODELS 追加的 id
LLM_PROVIDER=doubao
# 豆包：填入火山方舟的接入点/模型名（如 doubao-1-5-pro-32k-250115 等）
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=

# 其他内置 Provider（可选，切换时使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼 qwen（OpenAI 兼容）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash

# 零代码接入额外 OpenAI 兼容模型：JSON 数组（id/baseURL/apiKey/model），务必 URL 编码引号
LLM_EXTRA_MODELS=

# ---- 评测 judge（可选，独立于主模型的更强模型做 LLM-as-Judge）----
# JUDGE_PROVIDER=
# JUDGE_MODEL=

# ---- 向量 RAG / 语义检索（0.5.0，可选）----
# RAG_BACKEND=keyword           # keyword(默认纯关键词) | hybrid(需配 EMBEDDING_MODEL 启用语义检索)
# EMBEDDING_PROVIDER=           # 默认跟随 LLM_PROVIDER；可按 id 指定（复用该模型 baseURL/apiKey）
# EMBEDDING_MODEL=              # 嵌入模型名（如 qwen:text-embedding-v3 / doubao 嵌入模型）；未配则降级纯关键词
# EMBEDDING_DIM=1536            # 嵌入向量维度（按所选模型调整）

# ---- 语音 Provider（ASR/TTS，默认豆包语音）----
# ASR：火山「录音文件识别极速版」，需在控制台开通 volc.bigasr.auc_turbo 资源
ASR_PROVIDER=
ASR_APPID=
ASR_ACCESS_TOKEN=
# 资源 ID（默认 volc.bigasr.auc_turbo，一般无需改动）
ASR_RESOURCE_ID=
# TTS：火山经典同步合成接口（wav 输出）
TTS_PROVIDER=
TTS_APPID=
TTS_ACCESS_TOKEN=
# 集群（默认 volcano_tts）与音色（默认 BV001_streaming 经典女声）
TTS_CLUSTER=
TTS_VOICE_TYPE=

# ---- 反思调度（默认每周五 19:00）----
REFLECTION_CRON=0 19 * * 5
REMINDER_PROVIDER=web

# ---- 计划/复盘（0.4.0）----
# 锚定反思触发：连续 N 次复盘加权分 < 阈值 则自动修正画像锚点
PLAN_ANCHOR_STREAK=2
PLAN_ANCHOR_THRESHOLD=0.5
# 复盘加权评分权重（读取时自动归一化，四项和为 1 更佳）
PLAN_W_GOAL=0.4
PLAN_W_SIGNAL=0.2
PLAN_W_FREQ=0.2
PLAN_W_MASTERY=0.2
# 策略组合评测（进化门禁）：plan/review 各占权重与达标线
PLAN_EVAL_PLAN_W=0.5
PLAN_EVAL_REVIEW_W=0.5
PLAN_EVAL_MIN=6

# ---- 存储 ----
STORAGE_DIR=./data
KNOWLEDGE_DIR=./knowledge/skills

# ---- 流量回放录制（0.6.0，默认开）----
TRACING_ENABLED=true                      # 是否把真实对话录制为冻结线程
# TRACING_DIR=./data/threads              # 录制目录（默认复用 EVAL_THREADS_DIR）
# TRACING_GOLDEN_FILE=./data/threads/golden.json     # 黄金样本文件
TRACING_FAILURE_WEIGHT=3                  # fail-first 倍率（失败线程被抽中概率提升）
TRACING_SAMPLE_SIZE=50                    # 黄金样本刷新批次上限

# ---- 多节点部署（0.6.0，默认单机）----
# DEPLOY_MODE=single                      # single | multi
# LOCK_BACKEND=single                     # single(进程内) | file(文件锁) | db(SQLite锁表)
# LOCK_DIR=./data/locks
# LOCK_TTL_MS=300000                      # 锁租约 TTL（毫秒）

# ---- MCP Server（0.7.0，进程外 HTTP JSON-RPC，挂载于既有 Web 的 /mcp）----
MCP_ENABLED=true                          # false 时不挂载 /mcp，不影响 Web 服务
# MCP_TRANSPORT=http                      # http（当前）| stdio（预留）

# ---- 会话历史（BUG-004 修复：连续信号判定「连续 N 次 confused → hint」依赖它）----
# 参与判定的历史轮数上限；越大越准但越吃 token（需有界）
CONVERSATION_MAX_HISTORY=20
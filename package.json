{
  "name": "socratic-tutor",
  "version": "0.7.0",
  "description": "Conversational Socratic teaching agent (local web service)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test test/**/*.test.ts",
    "voice:verify": "node scripts/verify-voice.mjs",
    "seed:threads": "node scripts/seed-threads.mjs",
    "verify:bug004": "node scripts/verify-bug004.mjs",
    "assess:sample": "node scripts/assess-eval-sample.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.1",
    "node-cron": "^4.6.0",
    "openai": "^4.85.0",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
